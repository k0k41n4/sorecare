---
import '../styles/global.css';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Premium Hourly Private Nurse and Caregiver Service in Bali" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-zinc-800 antialiased font-sans">
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  h1, h2, h3, font-serif {
    font-family: 'Instrument Serif', serif;
  }
</style>